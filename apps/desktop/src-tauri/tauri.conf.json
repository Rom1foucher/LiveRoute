{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Live Route OCR",
  "version": "1.0.0",
  "identifier": "fr.romainfoucher.live-route-ocr",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Live Route · Grand Live planner",
        "width": 1680,
        "height": 1160,
        "minWidth": 1120,
        "minHeight": 940,
        "center": true
      },
      {
        "label": "vision-overlay",
        "title": "Live Route OCR Overlay",
        "url": "index.html?overlay=1",
        "width": 720,
        "height": 1280,
        "visible": false,
        "focus": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Local OCR companion for the Grand Live scenario",
    "longDescription": "Local screen snapshots for tokens, techniques and songs, with a passive decision overlay.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
